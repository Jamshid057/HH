# Copy to .env and fill in. .env is git-ignored.
DEBUG=True
# python -c "import secrets; print(secrets.token_urlsafe(50))"
SECRET_KEY=
ALLOWED_HOSTS=*
FRONTEND_URL=http://localhost:3000

# Google sign-in (OAuth client id from Google Cloud Console)
GOOGLE_CLIENT_ID=

# Gmail SMTP (use an app password). Leave empty to print emails to the console.
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=

# ---- Production (docker-compose.prod.yml) ----
# Public domain for automatic HTTPS (Caddy). Leave empty for http://localhost.
DOMAIN=
# Database (Postgres is used when POSTGRES_DB is set; otherwise SQLite)
POSTGRES_DB=myjob
POSTGRES_USER=myjob
POSTGRES_PASSWORD=
# Comma-separated origins, e.g. https://myjob.uz
CORS_ALLOWED_ORIGINS=
CSRF_TRUSTED_ORIGINS=
ALLOWED_HOSTS=myjob.uz
